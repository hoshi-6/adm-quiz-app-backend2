# Claude API キー（必須）https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# アクセス用パスコード。クラウド同期を使う場合は必須（データを守るため）
# アプリを初めて開いた端末で、この文字列を入力する
APP_PASSCODE=

# クラウド同期用の PostgreSQL（Vercel で Neon を接続すると自動で設定される）
# 未設定なら、データは各端末の中だけに保存される
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 使用するモデル（省略時: claude-opus-5）
# CLAUDE_MODEL=claude-opus-5

# 1 にすると AI の応答が速くなる高速モード（料金は約2倍。claude-opus-5 などの Opus 系のみ）
# CLAUDE_FAST_MODE=1

# 商品・食事の栄養を Web で調べるときだけ使うモデル（省略時は CLAUDE_MODEL と同じ）
# 例: claude-sonnet-5 にすると調べものが速く・安くなる（精度は少し下がることがある）
# CLAUDE_LOOKUP_MODEL=claude-sonnet-5
