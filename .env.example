# Claude API キー（必須）https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# アクセス用パスコード。クラウド同期を使う場合は必須（データを守るため）
# アプリを初めて開いた端末で、この文字列を入力する
APP_PASSCODE=

# クラウド同期用の PostgreSQL（Vercel で Neon を接続すると自動で設定される）
# 未設定なら、データは各端末の中だけに保存される
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 使用するモデル（省略時: claude-opus-5）
# CLAUDE_MODEL=claude-opus-5
